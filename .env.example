# ============================================================
#  ticket-notifier — 환경변수 예시
# ============================================================
#  사용법:
#   1) 이 파일을 .env 로 복사:  cp .env.example .env
#   2) 본인 정보를 채워넣기
#   3) .env는 .gitignore에 의해 절대 GitHub에 올라가지 않음
# ============================================================

# ──────────────────────────────────────────────────────────
#  무주산골영화제 예매자 인증 정보
# ──────────────────────────────────────────────────────────
#  실내상영·숙박패키지 모두 같은 정보 사용
#  - MJFF_PASS: 보통 생년월일 6자리(YYMMDD) 또는 사이트가 안내한 5~6자리
MJFF_NAME=홍길동
MJFF_PHONE=01000000000
MJFF_PASS=000000

# ──────────────────────────────────────────────────────────
#  ntfy (메인 알림 채널 — 무료, 가입 불필요)
# ──────────────────────────────────────────────────────────
#  토픽 이름: 짐작 불가능한 랜덤 문자열 권장
#  생성 팁: https://ntfy.sh/ 페이지에서 임의의 단어 + UUID 일부 조합
#  예) mjff-7a3f9b2c-watcher-2026
NTFY_TOPIC=mjff-CHANGE-ME-to-random-string

# 자체 호스팅 서버를 쓰면 변경 (기본은 공용 ntfy.sh)
NTFY_SERVER=https://ntfy.sh

# ──────────────────────────────────────────────────────────
#  Pushover (선택 — 새벽 알림용 Critical Alert)
# ──────────────────────────────────────────────────────────
#  iOS의 방해 금지 모드까지 무력화하고 싶을 때만 사용
#  앱 1회 결제 $5 + Application 생성 후 토큰 발급
#  설정 가이드: docs/SETUP_PUSHOVER.md
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# ──────────────────────────────────────────────────────────
#  텔레그램 봇 (선택 — 양방향 명령 + 영구 보존이 필요할 때)
# ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
